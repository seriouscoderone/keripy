# SAM build artifacts
.aws-sam/

# Prebuilt KeriRuntimeLayer asset (large/binary; regenerated by
# keri_cdk/layers/build_layer.sh, built in CI at release).
keri_cdk/layers/keri_runtime/

# Prebuilt ServiceAidFrameworkLayer asset (regenerated by
# keri_cdk/layers/build_framework_layer.sh, built in CI at release).
keri_cdk/layers/serviceaid_framework/

# Operator-specific deploy scripts / param files
*.local.sh
sam-*/deploy.local.sh
sam-*/params.local.json

# git worktrees (agent-isolated workspaces)
.worktrees/

# CDK synthesis output (generated by `cdk synth` or `python app.py`)
cdk.out/
ecosystems/*/cdk.out/

# Auto-generated deploy shim injected by inject_handler_shim() (generated artifact)
examples/gated_retrieval/handler.py
examples/schema_host/handler.py

# keri.host federation: real zone IDs + harvested AIDs are private, never committed
ecosystems/keri_host/federation.json
ecosystems/keri_host/federation_aids.json

# subagent-driven-development task reports (throwaway; the work lands in commits)
.superpowers-report-*.md
