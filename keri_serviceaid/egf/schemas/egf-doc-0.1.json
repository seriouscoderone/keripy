{
  "$id": "EN_gmhiwDmSG7opL28wM_Xn0wNOLx7K0e60sSNIPMQfR",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "egf-doc/0.1",
  "description": "Meta-schema for egf-doc/0.1: the SAID-native Ecosystem Governance Framework document. Validates EgfDocument instances (plain SADs, not ACDCs).",
  "type": "object",
  "required": [
    "d",
    "spec_version",
    "version",
    "ecosystem",
    "governance",
    "roles",
    "credentials",
    "authorities",
    "accepted_schema_saids",
    "micro_apps",
    "context_dimensions"
  ],
  "additionalProperties": false,
  "properties": {
    "d": {
      "type": "string",
      "pattern": "^E[A-Za-z0-9_-]{43}$"
    },
    "spec_version": {
      "const": "egf-doc/0.1"
    },
    "version": {
      "type": "string"
    },
    "ecosystem": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "openness",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "openness": {
          "enum": [
            "closed",
            "open"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "governance": {
      "type": "object",
      "required": [
        "phase",
        "transition_plan"
      ],
      "additionalProperties": false,
      "properties": {
        "phase": {
          "enum": [
            "bootstrap",
            "production"
          ]
        },
        "transition_plan": {
          "type": "string"
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "kind",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "individual",
              "organization",
              "system",
              "device",
              "agent",
              "government"
            ]
          },
          "description": {
            "type": "string"
          },
          "onboarding": {
            "type": "object",
            "required": [
              "grant_credential_id"
            ],
            "dependentRequired": {
              "request_micro_app_said": [
                "request_command_id"
              ],
              "request_command_id": [
                "request_micro_app_said"
              ]
            },
            "additionalProperties": false,
            "properties": {
              "grant_credential_id": {
                "type": "string"
              },
              "request_micro_app_said": {
                "type": "string",
                "pattern": "^E[A-Za-z0-9_-]{43}$"
              },
              "request_command_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "schema_said",
          "issuer_role",
          "disclosure_mode",
          "chained_from",
          "self_issued"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "schema_said": {
            "type": "string",
            "pattern": "^E[A-Za-z0-9_-]{43}$"
          },
          "issuer_role": {
            "type": "string"
          },
          "holder_role": {
            "type": "string"
          },
          "disclosure_mode": {
            "type": "string"
          },
          "chained_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "self_issued": {
            "type": "boolean"
          }
        }
      }
    },
    "authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role_id",
          "display_name",
          "aid",
          "phase",
          "context",
          "credentials",
          "endpoints",
          "phase_note",
          "expected_transition"
        ],
        "additionalProperties": false,
        "properties": {
          "role_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "aid": {
            "type": "string",
            "pattern": "^E[A-Za-z0-9_-]{43}$"
          },
          "phase": {
            "enum": [
              "bootstrap",
              "production"
            ]
          },
          "context": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Free-form dimension bindings (e.g. jurisdiction); keys are declared by context_dimensions, not fixed here. Values must be strings."
          },
          "credentials": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "type": "string"
                },
                "scheme": {
                  "type": "string"
                },
                "oobi_ref": {
                  "type": "string",
                  "pattern": "^E[A-Za-z0-9_-]{43}$"
                }
              }
            }
          },
          "phase_note": {
            "type": "string"
          },
          "expected_transition": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "accepted_schema_saids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^E[A-Za-z0-9_-]{43}$"
      }
    },
    "micro_apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "said",
          "id",
          "role_id"
        ],
        "additionalProperties": false,
        "properties": {
          "said": {
            "type": "string",
            "pattern": "^E[A-Za-z0-9_-]{43}$"
          },
          "id": {
            "type": "string"
          },
          "role_id": {
            "type": "string"
          }
        }
      }
    },
    "context_dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "applies_to_roles",
          "kind",
          "values_ref",
          "prompt",
          "binds"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "applies_to_roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "type": "string"
          },
          "values_ref": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "binds": {
            "type": "string"
          }
        }
      }
    }
  }
}
